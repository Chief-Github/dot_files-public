{
	"$schema": "vscode://schemas/color-theme",
	"name": "Chief Theme (Dynamic)",
	"type": "dark",
	"colors": {
		"activityBar.background": "{{colors.surface_container.default.hex}}",
		"badge.background": "{{colors.primary.default.hex}}",
		"badge.foreground": "{{colors.on_primary.default.hex}}",
		"button.background": "{{colors.primary.default.hex}}",
		"button.foreground": "{{colors.on_primary.default.hex}}",
		"debugExceptionWidget.background": "{{colors.surface_container_lowest.default.hex}}",
		"debugExceptionWidget.border": "{{colors.error.default.hex}}",
		"debugToolBar.background": "{{colors.surface_container_lowest.default.hex}}",
		"dropdown.background": "{{colors.surface_container_lowest.default.hex}}",
		"dropdown.border": "{{colors.primary.default.hex}}99",
		"editor.background": "{{colors.surface.default.hex}}",
		"editor.foreground": "{{colors.on_surface.default.hex}}",
		"editor.lineHighlightBackground": "{{colors.surface_container.default.hex}}",
		"editor.selectionBackground": "{{colors.primary_container.default.hex}}",
		"editor.selectionHighlightBackground": "{{colors.secondary_container.default.hex}}aa",
		"editor.wordHighlightBackground": "{{colors.surface_container_high.default.hex}}aa",
		"editor.wordHighlightStrongBackground": "{{colors.secondary_container.default.hex}}aa",
		"editorBracketHighlight.foreground1": "{{colors.primary.default.hex}}",
		"editorBracketHighlight.foreground2": "{{colors.secondary.default.hex}}",
		"editorBracketHighlight.foreground3": "{{colors.tertiary.default.hex}}",
		"editorCursor.foreground": "{{colors.primary.default.hex}}",
		"editorGroup.border": "{{colors.surface_container_lowest.default.hex}}",
		"editorGroup.dropBackground": "{{colors.primary.default.hex}}44",
		"editorGroupHeader.tabsBackground": "{{colors.surface_container_high.default.hex}}",
		"editorHoverWidget.background": "{{colors.surface_container_high.default.hex}}",
		"editorLineNumber.activeForeground": "{{colors.on_surface_variant.default.hex}}",
		"editorMarkerNavigationError.background": "{{colors.error.default.hex}}",
		"editorMarkerNavigationWarning.background": "{{colors.tertiary.default.hex}}",
		"editorWhitespace.foreground": "{{colors.outline_variant.default.hex}}80",
		"editorWidget.background": "{{colors.surface_container_lowest.default.hex}}",
		"errorForeground": "{{colors.error.default.hex}}",
		"focusBorder": "{{colors.primary.default.hex}}99",
		"input.background": "{{colors.surface_container.default.hex}}",
		"input.foreground": "{{colors.on_surface.default.hex}}",
		"input.placeholderForeground": "{{colors.on_surface_variant.default.hex}}aa",
		"inputOption.activeBorder": "{{colors.primary.default.hex}}99",
		"inputValidation.errorBackground": "{{colors.error_container.default.hex}}",
		"inputValidation.errorBorder": "{{colors.error.default.hex}}",
		"inputValidation.infoBackground": "{{colors.secondary_container.default.hex}}",
		"inputValidation.infoBorder": "{{colors.secondary.default.hex}}",
		"inputValidation.warningBackground": "{{colors.tertiary_container.default.hex}}",
		"inputValidation.warningBorder": "{{colors.tertiary.default.hex}}",
		"list.activeSelectionBackground": "{{colors.primary_container.default.hex}}",
		"list.activeSelectionForeground": "{{colors.on_primary_container.default.hex}}",
		"list.dropBackground": "{{colors.surface_container_high.default.hex}}88",
		"list.highlightForeground": "{{colors.primary.default.hex}}",
		"list.hoverBackground": "{{colors.surface_container_high.default.hex}}aa",
		"list.inactiveSelectionBackground": "{{colors.surface_container_high.default.hex}}88",
		"minimap.selectionHighlight": "{{colors.primary_container.default.hex}}",
		"panel.border": "{{colors.outline_variant.default.hex}}",
		"peekView.border": "{{colors.outline_variant.default.hex}}",
		"peekViewEditor.background": "{{colors.surface_container_lowest.default.hex}}",
		"peekViewEditor.matchHighlightBackground": "{{colors.tertiary.default.hex}}40",
		"peekViewResult.background": "{{colors.surface_container_lowest.default.hex}}",
		"peekViewTitle.background": "{{colors.surface_container_lowest.default.hex}}",
		"pickerGroup.border": "{{colors.primary.default.hex}}99",
		"pickerGroup.foreground": "{{colors.primary.default.hex}}",
		"ports.iconRunningProcessForeground": "{{colors.tertiary.default.hex}}",
		"progressBar.background": "{{colors.primary.default.hex}}",
		"quickInputList.focusBackground": "{{colors.primary_container.default.hex}}",
		"selection.background": "{{colors.primary.default.hex}}99",
		"sideBar.background": "{{colors.surface_container_lowest.default.hex}}",
		"sideBarTitle.foreground": "{{colors.on_surface.default.hex}}",
		"statusBar.background": "{{colors.surface_container_lowest.default.hex}}",
		"statusBar.debuggingBackground": "{{colors.surface_container_lowest.default.hex}}",
		"statusBar.foreground": "{{colors.on_surface.default.hex}}",
		"statusBar.noFolderBackground": "{{colors.surface_container_lowest.default.hex}}",
		"statusBarItem.prominentBackground": "{{colors.surface_container.default.hex}}",
		"statusBarItem.prominentHoverBackground": "{{colors.surface_container_high.default.hex}}",
		"statusBarItem.remoteBackground": "{{colors.primary.default.hex}}",
		"statusBarItem.remoteForeground": "{{colors.on_primary.default.hex}}",
		"tab.activeBackground": "{{colors.surface.default.hex}}",
		"tab.activeForeground": "{{colors.on_surface.default.hex}}",
		"tab.border": "{{colors.surface_container.default.hex}}",
		"tab.inactiveBackground": "{{colors.surface_container_high.default.hex}}",
		"tab.inactiveForeground": "{{colors.on_surface_variant.default.hex}}",
		"tab.lastPinnedBorder": "{{colors.primary.default.hex}}44",
		"terminal.background": "{{colors.surface.default.hex}}",
		"terminal.foreground": "{{colors.on_surface.default.hex}}",
		"terminal.ansiBlack": "#4c4c4c",
		"terminal.ansiBlue": "{{colors.primary.default.hex}}",
		"terminal.ansiBrightBlack": "#262626",
		"terminal.ansiBrightBlue": "#a39ec4",
		"terminal.ansiBrightCyan": "#9ec3c4",
		"terminal.ansiBrightGreen": "#9ec49f",
		"terminal.ansiBrightMagenta": "#c49ec4",
		"terminal.ansiBrightRed": "#c49ea0",
		"terminal.ansiBrightWhite": "#e7e7e7",
		"terminal.ansiBrightYellow": "#c4c19e",
		"terminal.ansiCyan": "#8aacab",
		"terminal.ansiGreen": "#8aac8b",
		"terminal.ansiMagenta": "#ac8aac",
		"terminal.ansiRed": "#ac8a8c",
		"terminal.ansiWhite": "#f0f0f0",
		"terminal.ansiYellow": "#aca98a",
		"titleBar.activeBackground": "{{colors.surface_container_lowest.default.hex}}",
		"titleBar.activeForeground": "{{colors.on_surface.default.hex}}"
	},
	"tokenColors": [
		{
			"scope": ["meta.embedded", "source.groovy.embedded"],
			"settings": { "foreground": "{{colors.on_surface.default.hex}}" }
		},
		{
			"scope": "comment",
			"settings": { "foreground": "{{colors.outline.default.hex}}", "fontStyle": "italic" }
		},
		{
			"scope": "string",
			"settings": { "foreground": "{{colors.tertiary.default.hex}}" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
			"settings": { "foreground": "{{colors.secondary_fixed_dim.default.hex}}" }
		},
		{
			"scope": ["keyword", "storage.type", "storage.modifier"],
			"settings": { "foreground": "{{colors.primary.default.hex}}" }
		},
		{
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "{{colors.secondary.default.hex}}" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
			"settings": { "foreground": "{{colors.primary_fixed_dim.default.hex}}" }
		},
		{
			"scope": "variable",
			"settings": { "foreground": "{{colors.on_surface.default.hex}}" }
		},
		{
			"scope": "entity.name.tag",
			"settings": { "foreground": "{{colors.primary.default.hex}}" }
		},
		{
			"scope": "entity.other.attribute-name",
			"settings": { "foreground": "{{colors.secondary.default.hex}}" }
		},
		{
			"scope": "markup.heading",
			"settings": { "foreground": "{{colors.primary.default.hex}}", "fontStyle": "bold" }
		},
		{
			"scope": "invalid",
			"settings": { "foreground": "{{colors.error.default.hex}}" }
		}
	]
}
