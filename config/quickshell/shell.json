{
  "appearance": {
    "fontFamily": "Inter",
    "materialIconFont": "Material Design Icons"
  },
  "paths": {
    "pywalColors": "~/.cache/wal/colors.json",
    "screenshotsDir": "~/screenshots"
  },
  "osd": {
    "volumeTimeoutMs": 2000,
    "brightnessTimeoutMs": 2000
  },
  "notifications": {
    "popupWidth": 340,
    "maxVisible": 5,
    "timeoutMs": 7000,
    "registerServer": false,
    "spacing": 10,
    "margin": 10
  },
  "sidebar": {
    "enabled": true,
    "width": 420,
    "margin": 12,
    "maxHistory": 80
  },
  "dashboard": {
    "enabled": true,
    "width": 860,
    "height": 660,
    "margin": 18
  }
}
