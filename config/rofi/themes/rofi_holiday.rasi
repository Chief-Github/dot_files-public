/************************************************
 * ROFI Color theme
 * User: Chief-Github, originally, leofa
 * https://github.com/Chief-Github
 ***********************************************/

* {
  /* Text */
  foreground:                  rgba(240, 246, 252, 100%);       
  normal-foreground:           @foreground;
  selected-normal-foreground:  rgba(28, 35, 42, 100%);           
  urgent-foreground:           rgba(242, 153, 133, 100%);       
  selected-urgent-foreground:  rgba(28, 35, 42, 100%);
  active-foreground:           rgba(100, 174, 255, 100%);
  selected-active-foreground:  rgba(28, 35, 42, 100%);

  /* Backgrounds */
  background:                  rgba(230, 243, 255, 0%);
  normal-background:           @background;

  /* Selected row = bright sky blue */
  selected-normal-background:  rgba(100, 174, 255, 95%);
  selected-urgent-background:  rgba(252, 191, 161, 90%);
  selected-active-background:  rgba(158, 220, 255, 95%);

  /* Passive states */
  active-background:           rgba(200, 235, 255, 40%);
  urgent-background:           rgba(255, 220, 200, 30%);

  /* Window glass */
  background-color:            rgba(20, 54, 94, 40%);
  border-colour:               rgba(20, 54, 94, 50%);        
  border-color:                @border-colour;

  /* Layout */
  spacing:                     4;
  separatorcolor:              rgba(180, 210, 230, 60%);
}


configuration {


    kb-element-next: "";
    kb-mode-next: "Tab";


    /*drun,window,run,filebrowser,keys */
	modi: "drun,window,run,power:~/.config/rofi/powermenu.sh,theme:~/.config/rofi/theme_switcher.sh,PP:~/.config/rofi/Power_profile_switcher.sh";
	show-icons: true;
	sidebar-mode: true;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               10px;
}
window {
    background-color: @background;
    border:           1;
    padding:          5;


    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;


    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      15px solid;
    border-radius:               10px;
    border-color:                @border-colour;
    background-color:            @background;
    cursor:                      "default";

}
mainbox {

    border:  0px;
    padding: 0;
    border-radius:  10px;
}
message {
    border:       2px 0px 0px ;
    border-color: @separatorcolor;
    padding:      1px ;
}
textbox {
    text-color: @foreground;
}
element.alternate.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}
element.alternate.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}
element.alternate.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}
listview {
    fixed-height: 0;
    border:       2px 0px 0px ;
    border-color: @separatorcolor;
    spacing:      2px ;
    scrollbar:    false;
    padding:      2px 0px 0px ;
}
element {
    border:  0;
    padding: 1px ;
}
element-text {
    background-color: inherit;
    text-color:       inherit;
}
element.normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}
element.normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}
element.normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}
element.selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}
element.selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-active-foreground;
}
scrollbar {
    width:        4px ;
    border:       0;
    handle-color: @normal-foreground;
    handle-width: 8px ;
    padding:      0;
}
mode-switcher {
    border:       2px 0px 0px ;
    border-color: @separatorcolor;
}
button {
    spacing:    0;
    text-color: @normal-foreground;
}
button.selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
inputbar {
    spacing:    0;
    text-color: @normal-foreground;
    padding:    1px ;
}
case-indicator {
    spacing:    0;
    text-color: @normal-foreground;
}
entry {
    spacing:    0;
    text-color: @normal-foreground;
}
prompt {
    spacing:    0;
    text-color: @normal-foreground;
}
inputbar {
    children:   [ prompt,textbox-prompt-colon,entry,case-indicator ];
}
textbox-prompt-colon {
    expand:     false;
    str:        ":";
    margin:     0px 0.3em 0em 0em ;
    text-color: @normal-foreground;
}


